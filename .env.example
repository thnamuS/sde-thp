# Nexora local development environment
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#   docker compose up --build
#
# Values in this file are for local demo use only. Replace every secret before
# sharing or deploying the project.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev
DATABASE_URL=postgres://nexora:nexora_dev@postgres:5432/nexora?sslmode=disable
DBOS_SYSTEM_DATABASE_URL=postgres://nexora:nexora_dev@postgres:5432/nexora?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Application security
# -----------------------------------------------------------------------------
# Use different high-entropy values in any shared environment.
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SECRET=replace-with-a-different-random-secret

# -----------------------------------------------------------------------------
# Seeded local admin account
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@nexora.local
ADMIN_PASSWORD=ChangeMe123!

# -----------------------------------------------------------------------------
# OpenRouter AI
# -----------------------------------------------------------------------------
# Optional. Leave OPENROUTER_API_KEY empty to run the core system without live AI.
# The assistant endpoint returns 503 without this key; workers use fallback text.
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
PUBLIC_BASE_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Browser-facing frontend config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Demo tenants, workers, and webhooks
# -----------------------------------------------------------------------------
# These API keys are seeded for the Acme/Lorem demo tenants and used by the
# outbound-only enterprise workers. Change them before any non-local use.
ACME_API_KEY=nx_test_acme_local_demo_change_before_deployment
LOREM_API_KEY=nx_test_lorem_local_demo_change_before_deployment
ENTERPRISE_WORKER_API_KEY=nx_test_acme_local_demo_change_before_deployment

# Used by the Acme demo webhook receiver to validate Nexora webhook signatures.
ACME_WEBHOOK_SECRET=change-this-local-demo-webhook-secret

# -----------------------------------------------------------------------------
# Optional runtime tuning
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30

# Reserved for future structured logging configuration; currently not read by
# the Go services.
LOG_LEVEL=info
